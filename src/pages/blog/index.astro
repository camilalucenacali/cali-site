---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { getCollection } from 'astro:content';
import '../../styles/blog.css';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Blog — CALI MOVIMIENTO by Camila Lucena"
  description="Escritas sobre movimento, yoga, autoconhecimento e sentir corporal. Por Camila Lucena."
>
  <Header />

  <section class="blog-hero section-pad page-top">
    <div class="prism" id="prismBlog"></div>
    <div class="wrap">
      <span class="eyebrow reveal">escritas</span>
      <h1 class="reveal">Escritas do<br />movimento</h1>
      <p class="lede reveal">Corpo como texto. Movimento como linguagem.</p>
    </div>
  </section>

  <section class="section-pad" style="background:var(--paper);">
    <div class="wrap">
      {posts.length === 0 ? (
        <p style="text-align:center;color:var(--ink-soft);">Posts em breve.</p>
      ) : (
        <div class="post-list">
          {posts.map((post, i) => (
            <a href={`/blog/${post.slug}`} class="post-row reveal" style={`transition-delay:${i*0.1}s`}>
              <div class="pr-date">
                {post.data.pubDate.toLocaleDateString('pt-BR',{day:'2-digit',month:'short'})}
                <small>{post.data.pubDate.getFullYear()}</small>
              </div>
              <div>
                <span class="pr-title">{post.data.title}</span>
                <span class="pr-tags">{post.data.tags.slice(0,4).join(' · ')}</span>
              </div>
              <span class="pr-go">→</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <Footer />
  <WhatsAppButton />
</BaseLayout>

<script is:inline>
(function() {
  if (!window.gsap || !window.ScrollTrigger) return;
  var p = document.getElementById('prismBlog');
  if (p) gsap.fromTo(p,{yPercent:-6},{yPercent:6,ease:'none',
    scrollTrigger:{trigger:p.parentElement,start:'top bottom',end:'bottom top',scrub:true}});
})();
</script>
