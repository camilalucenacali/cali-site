---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

const appUrl = 'https://calispinelab.vercel.app';
const waUrl  = 'https://wa.me/5551999595522?text=' + encodeURIComponent('Olá! Me inscrevi na lista da Spine Lab e gostaria de agendar minha conversa de 15 min com a Camila.');
const mandala = '/assets/spine-mandala.png';
---

<BaseLayout
  title="APP Spine Lab — CALI MOVIMIENTO"
  description="O Spine Lab está em fase beta. Uma jornada de respiração consciente e movimento da coluna — acesso via conversa com a Cami."
>
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
  />

  <Header />

  <div class="sl-page">

    <!-- ════════════════════ HERO ════════════════════ -->
    <header class="hero" id="hero">
      <p class="eyebrow hero-eyebrow">Respiração <span class="dot">·</span> Movimento <span class="dot">·</span> Coluna</p>

      <div class="mandala-wrap">
        <img class="mandala" src={mandala} alt="Símbolo Spine Lab — mandala em gradiente prisma" />
      </div>

      <h1 class="display">A sua jornada. <em>O seu ritmo.</em> O seu corpo.</h1>
      <p class="lead hero-lead">Uma prática diária de respiração e movimento com raiz nos Yoga Sutras de Patanjali — organizada em ciclos de 28 dias que cabem em 5, 10 ou 21 minutos.</p>

      <div class="hero-actions">
        <a class="btn btn-primary" href={waUrl}>Entrar na lista de espera <span class="arr">→</span></a>
        <a class="btn btn-ghost" href={appUrl} target="_blank" rel="noopener">Acessar o app <span class="arr">↗</span></a>
      </div>

      <p class="hero-note"><span class="live"></span> 10 conversas por semana · próxima liberação: segunda-feira</p>

      <a class="scroll-cue" href="#manifesto" aria-label="Rolar">
        <span>Respire</span>
        <span class="line"></span>
      </a>
    </header>

    <!-- ════════════════════ MANIFESTO ════════════════════ -->
    <section class="manifesto" id="manifesto">
      <div class="wrap">
        <p class="quote reveal">Acreditamos que o corpo sabe o caminho. E que <em>cinco minutos</em> de presença real valem mais que uma hora de distração.</p>
        <p class="attr reveal">Manifesto Spine Lab</p>
      </div>
    </section>

    <!-- ════════════════════ COMO FUNCIONA ════════════════════ -->
    <section class="section" id="como-funciona">
      <div class="wrap">
        <div class="section-head reveal">
          <span class="eyebrow">Como funciona</span>
          <h2>Uma jornada, <em>não um catálogo.</em></h2>
          <p>Cada aula prepara a próxima. Cada fase aprofunda a anterior. Cada ciclo de 28 dias marca uma transformação concreta — sem pular, e isso não é limitação, é design.</p>
        </div>

        <div class="equation reveal">
          <div class="eq-item"><div class="num">1</div><div class="lbl">Ciclo</div></div>
          <div class="eq-op">=</div>
          <div class="eq-item"><div class="num">7</div><div class="lbl">Fases</div></div>
          <div class="eq-op">×</div>
          <div class="eq-item"><div class="num">4</div><div class="lbl">Dias</div></div>
          <div class="eq-op">=</div>
          <div class="eq-item"><div class="num">28</div><div class="lbl">Dias de prática</div></div>
        </div>

        <div class="days">
          <div class="day reveal">
            <div class="d-num">Dia 1</div>
            <div class="d-role">Compreender</div>
            <p class="d-desc">Introdução teórica e a experiência inicial — o que vai acontecer e por quê.</p>
          </div>
          <div class="day reveal">
            <div class="d-num">Dia 2</div>
            <div class="d-role">Praticar</div>
            <p class="d-desc">Prática mais intensa e consistente — para consolidar o que foi apresentado.</p>
          </div>
          <div class="day reveal">
            <div class="d-num">Dia 3</div>
            <div class="d-role">Integrar</div>
            <p class="d-desc">Meditação orientada para o tema da fase — levar o aprendizado para o interno.</p>
          </div>
          <div class="day reveal">
            <div class="d-num">Dia 4</div>
            <div class="d-role">Assimilar</div>
            <p class="d-desc">Savasana guiado — corpo e mente absorvem o que foi aprendido.</p>
          </div>
        </div>

        <div class="durations">
          <div class="dur-head reveal">
            <h3>A mesma prática, na medida do seu dia.</h3>
            <p>Cada aula existe em três durações que passam o mesmo conhecimento — escolha conforme o tempo e a energia disponíveis.</p>
          </div>
          <div class="dur-cards">
            <div class="dur reveal"><div class="t">5<span> min</span></div><p class="c">Versão concisa e direta, para os dias de pouco tempo.</p></div>
            <div class="dur reveal"><div class="t">10<span> min</span></div><p class="c">Inclui asanas básicos para o bem-estar do corpo.</p></div>
            <div class="dur reveal"><div class="t">21<span> min</span></div><p class="c">Mini prática de Hatha completa, para ir mais fundo.</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════ LISTA DE ESPERA ════════════════════ -->
    <section class="waitlist" id="lista">
      <div class="wrap">
        <div class="wait-inner reveal">
          <img class="wait-mandala" src={mandala} alt="" />
          <h2>Entre para as <em>primeiras praticantes.</em></h2>
          <p class="lead">O acesso à Spine Lab começa com uma conversa de 15 min com a Cami — são 10 vagas por semana. Deixe seu contato e a gente abre o WhatsApp para agendar.</p>

          <form class="wl-form" id="wl-form" novalidate>
            <div class="field" id="f-nome">
              <label for="nome">Nome</label>
              <input type="text" id="nome" name="nome" placeholder="Como podemos te chamar?" autocomplete="given-name" />
              <span class="err">Conta pra gente seu nome.</span>
            </div>
            <div class="field" id="f-email">
              <label for="email">E-mail</label>
              <input type="email" id="email" name="email" placeholder="seu@email.com" autocomplete="email" />
              <span class="err">Confere o e-mail, parece incompleto.</span>
            </div>
            <div class="field" id="f-motivo">
              <label for="motivo">O que te traz aqui? <span class="optional">(opcional)</span></label>
              <select id="motivo" name="motivo">
                <option value="">Escolha uma opção</option>
                <option>Dor nas costas ou no pescoço</option>
                <option>Ansiedade e clareza mental</option>
                <option>Quero mais consistência</option>
                <option>Curiosidade sobre a prática</option>
              </select>
            </div>
            <button type="submit" class="btn btn-primary">Falar com a Cami no WhatsApp <span class="arr">→</span></button>
            <p class="wl-fine">Sem spam. Abrimos o WhatsApp da Cami para agendar sua conversa.</p>
          </form>

          <div class="wl-success" id="wl-success">
            <div class="check"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5 11-12"/></svg></div>
            <h3>Você está na lista.</h3>
            <p id="wl-success-msg">Abrimos o WhatsApp da Cami para agendar sua conversa.</p>
          </div>
        </div>
      </div>
    </section>

  </div>

  <Footer />
  <WhatsAppButton text="Olá! Quero saber mais sobre o Spine Lab e entrar na lista de espera." />
</BaseLayout>

<script is:inline>
(function () {
  var form    = document.getElementById('wl-form');
  var success = document.getElementById('wl-success');
  if (!form) return;
  var nome   = document.getElementById('nome');
  var email  = document.getElementById('email');
  var motivo = document.getElementById('motivo');
  var fNome  = document.getElementById('f-nome');
  var fEmail = document.getElementById('f-email');
  var emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function clearOn(input, field) {
    input.addEventListener('input', function () { field.classList.remove('invalid'); });
  }
  clearOn(nome, fNome);
  clearOn(email, fEmail);

  form.addEventListener('submit', function (ev) {
    ev.preventDefault();
    var ok = true;
    if (!nome.value.trim()) { fNome.classList.add('invalid'); ok = false; }
    if (!emailRe.test(email.value.trim())) { fEmail.classList.add('invalid'); ok = false; }
    if (!ok) {
      var firstBad = form.querySelector('.invalid input');
      if (firstBad) firstBad.focus();
      return;
    }

    var first = nome.value.trim().split(/\s+/)[0];
    var msg = document.getElementById('wl-success-msg');
    msg.textContent = (first ? first + ', abrimos o WhatsApp da Cami — ' : 'Abrimos o WhatsApp da Cami — ') +
      'é só enviar a mensagem para agendar sua conversa de 15 min.';

    var lines = [
      'Olá Cami! Me inscrevi na lista da Spine Lab e gostaria de agendar minha conversa de 15 min.',
      '',
      'Nome: ' + nome.value.trim(),
      'E-mail: ' + email.value.trim()
    ];
    if (motivo.value) lines.push('O que me traz: ' + motivo.value);
    var waUrl = 'https://wa.me/5551999595522?text=' + encodeURIComponent(lines.join('\n'));
    window.open(waUrl, '_blank', 'noopener');

    form.style.display = 'none';
    success.classList.add('show');
  });
})();
</script>

<style>
  /* ════════════════════════════════════════════════════════
     SPINE LAB — escopado em .sl-page (não afeta o resto do site)
     Serene + ritual. A mandala prisma é a única cor forte.
     ════════════════════════════════════════════════════════ */
  .sl-page {
    /* neutros bone quentes — deixam o prisma respirar */
    --bg:        #F4F0E9;
    --bg-raised: #FBF8F2;
    --bg-deep:   #ECE6DB;
    --line:      #E2DACB;

    --ink:       #322A33;
    --ink-soft:  #6E6570;
    --ink-faint: #9A9098;

    --coral:     #FF7F5C;
    --magenta:   #FF4D9F;
    --lavender:  #8B9FFF;
    --sage:      #5A7F6F;
    --peach:     #FF9966;

    --accent:    #E8714E;
    --accent-ink:#FFFFFF;
    --prism:     1;
    --spin:      150s;

    --grad-prisma: linear-gradient(135deg, var(--coral) 0%, var(--magenta) 50%, var(--lavender) 100%);
    --maxw: 1180px;
    --ease: cubic-bezier(.22,.61,.36,1);

    --font-display: "Cormorant Garamond", Georgia, serif;
    --font-body: "Hanken Grotesk", system-ui, sans-serif;

    position: relative;
    z-index: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.65;
  }

  /* lavagem prisma suave no topo */
  .sl-page::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 80% at 50% -6%, rgba(255,127,92, calc(0.10 * var(--prism))), transparent 55%),
      radial-gradient(90% 60% at 85% 10%, rgba(139,159,255, calc(0.10 * var(--prism))), transparent 55%),
      radial-gradient(80% 50% at 10% 6%, rgba(255,77,159, calc(0.07 * var(--prism))), transparent 55%);
    pointer-events: none;
    z-index: 0;
  }
  .sl-page > * { position: relative; z-index: 1; }

  .sl-page .wrap { width: 100%; max-width: var(--maxw); margin: 0 auto; padding: 0 32px; }
  .sl-page ::selection { background: rgba(255,127,92,.22); }

  /* ── tipografia compartilhada ── */
  .sl-page .eyebrow {
    font-family: var(--font-body);
    font-size: .72rem; font-weight: 700;
    letter-spacing: .30em; text-transform: uppercase;
    color: var(--ink-faint);
  }
  .sl-page .eyebrow .dot { color: var(--accent); }
  .sl-page .display {
    font-family: var(--font-display);
    font-weight: 400; line-height: 1.03;
    letter-spacing: -.012em; color: var(--ink);
  }
  .sl-page .lead {
    font-size: clamp(1.05rem, 1.4vw, 1.28rem);
    color: var(--ink-soft); line-height: 1.6;
  }

  /* ── botões (pílula, coral) ── */
  .sl-page .btn {
    display: inline-flex; align-items: center; gap: .6em;
    font-family: var(--font-body); font-weight: 600;
    font-size: .98rem; letter-spacing: .01em;
    padding: 1.05em 1.8em; border-radius: 999px;
    border: 1px solid transparent; cursor: pointer;
    transition: transform .4s var(--ease), box-shadow .4s var(--ease), background .3s, color .3s;
    white-space: nowrap;
  }
  .sl-page .btn-primary {
    background: var(--accent); color: var(--accent-ink);
    box-shadow: 0 14px 34px -14px color-mix(in oklab, var(--accent), transparent 28%);
  }
  .sl-page .btn-primary:hover { transform: translateY(-3px); background: var(--accent); box-shadow: 0 22px 44px -16px color-mix(in oklab, var(--accent), transparent 22%); }
  .sl-page .btn-ghost { background: transparent; color: var(--ink); border-color: var(--line); }
  .sl-page .btn-ghost:hover { border-color: var(--ink-faint); transform: translateY(-2px); background: transparent; }
  .sl-page .btn .arr { transition: transform .4s var(--ease); }
  .sl-page .btn:hover .arr { transform: translateX(4px); }

  /* ════════════════════ HERO ════════════════════ */
  .sl-page .hero {
    position: relative; z-index: 1;
    min-height: 100svh;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center;
    padding: 130px 32px 90px;
  }
  .sl-page .hero-eyebrow { margin-bottom: 34px; }

  .sl-page .mandala-wrap {
    position: relative;
    width: clamp(230px, 34vw, 380px);
    aspect-ratio: 1;
    display: grid; place-items: center;
  }
  .sl-page .mandala-wrap::before {
    content: ""; position: absolute; inset: -28%;
    background: conic-gradient(from 0deg,
       var(--coral), var(--peach), #F2D27A, var(--sage),
       var(--lavender), var(--magenta), var(--coral));
    filter: blur(58px);
    opacity: calc(.32 * var(--prism));
    border-radius: 50%;
    animation: slSpin var(--spin) linear infinite reverse;
  }
  .sl-page .mandala {
    position: relative; width: 100%; height: 100%;
    animation: slSpin var(--spin) linear infinite;
    filter: drop-shadow(0 24px 60px rgba(255,127,92, calc(.18 * var(--prism))));
  }
  @keyframes slSpin { to { transform: rotate(360deg); } }

  .sl-page .hero h1 {
    font-size: clamp(2.9rem, 7.2vw, 6.2rem);
    margin-top: 26px; max-width: 14ch;
  }
  .sl-page .hero h1 em { color: var(--accent); font-weight: 500; font-style: italic; font-family: var(--font-display); }
  .sl-page .hero-lead { margin-top: 26px; max-width: 46ch; }
  .sl-page .hero-actions { margin-top: 40px; display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
  .sl-page .hero-note {
    margin-top: 26px; font-size: .82rem; color: var(--ink-faint);
    display: flex; align-items: center; gap: 9px;
  }
  .sl-page .hero-note .live {
    width: 7px; height: 7px; border-radius: 50%; background: var(--sage);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--sage), transparent 40%);
    animation: slPulse 2.6s infinite;
  }
  @keyframes slPulse {
    0% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--sage), transparent 35%); }
    70% { box-shadow: 0 0 0 9px color-mix(in oklab, var(--sage), transparent 100%); }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  .sl-page .scroll-cue {
    position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%);
    font-size: .68rem; letter-spacing: .26em; text-transform: uppercase;
    color: var(--ink-faint); display: flex; flex-direction: column; align-items: center; gap: 10px;
  }
  .sl-page .scroll-cue .line { width: 1px; height: 40px; background: linear-gradient(var(--ink-faint), transparent); animation: slCue 2.4s var(--ease) infinite; }
  @keyframes slCue { 0%,100%{ transform: scaleY(.6); opacity:.5;} 50%{ transform: scaleY(1); opacity:1;} }

  /* ════════════════════ MANIFESTO ════════════════════ */
  .sl-page .manifesto { padding: clamp(90px, 13vw, 170px) 32px; text-align: center; }
  .sl-page .manifesto .quote {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.6vw, 3.6rem);
    font-weight: 400; line-height: 1.18; letter-spacing: -.01em;
    max-width: 18ch; margin: 0 auto; color: var(--ink);
  }
  .sl-page .manifesto .quote em { color: var(--accent); font-style: italic; }
  .sl-page .manifesto .attr {
    margin-top: 30px; font-size: .76rem; letter-spacing: .26em; text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* ════════════════════ COMO FUNCIONA ════════════════════ */
  .sl-page .section { padding: clamp(80px, 11vw, 150px) 0; }
  .sl-page .section-head { max-width: 60ch; }
  .sl-page .section-head .eyebrow { display: block; margin-bottom: 22px; }
  .sl-page .section-head h2 {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(2.1rem, 4.6vw, 3.5rem); line-height: 1.08; letter-spacing: -.012em;
  }
  .sl-page .section-head h2 em { color: var(--accent); font-style: italic; font-weight: 500; }
  .sl-page .section-head p { margin-top: 22px; max-width: 52ch; color: var(--ink-soft); }

  .sl-page .equation {
    margin: clamp(48px, 7vw, 86px) 0;
    display: flex; align-items: center; justify-content: center; flex-wrap: wrap;
    gap: clamp(18px, 4vw, 54px); text-align: center;
  }
  .sl-page .eq-item .num {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(3.4rem, 9vw, 6.4rem); line-height: .9;
    background: var(--grad-prisma); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .sl-page .eq-item .lbl { margin-top: 12px; font-size: .8rem; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-soft); }
  .sl-page .eq-op { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); color: var(--ink-faint); }

  .sl-page .days { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .sl-page .day {
    background: var(--bg-raised); border: 1px solid var(--line);
    border-radius: 22px; padding: 30px 26px 34px;
    position: relative; overflow: hidden;
    transition: transform .5s var(--ease), box-shadow .5s var(--ease), border-color .5s;
  }
  .sl-page .day::before {
    content: ""; position: absolute; left: 0; top: 0; right: 0; height: 3px;
    background: var(--grad-prisma); opacity: .85;
    transform: scaleX(.18); transform-origin: left; transition: transform .6s var(--ease);
  }
  .sl-page .day:hover { transform: translateY(-6px); box-shadow: 0 30px 60px -34px rgba(50,42,51,.35); border-color: transparent; }
  .sl-page .day:hover::before { transform: scaleX(1); }
  .sl-page .day .d-num { font-family: var(--font-display); font-size: 1.05rem; color: var(--ink-faint); letter-spacing: .04em; }
  .sl-page .day .d-role { font-family: var(--font-display); font-size: 1.7rem; margin-top: 4px; color: var(--ink); }
  .sl-page .day .d-desc { margin-top: 14px; font-size: .94rem; color: var(--ink-soft); line-height: 1.55; }

  .sl-page .durations { margin-top: clamp(54px, 7vw, 90px); display: flex; gap: 16px; flex-wrap: wrap; align-items: stretch; }
  .sl-page .dur-head { flex: 1 1 240px; align-self: center; }
  .sl-page .dur-head h3 { font-family: var(--font-display); font-size: clamp(1.5rem,2.4vw,2rem); font-weight: 400; line-height: 1.15; }
  .sl-page .dur-head p { margin-top: 12px; color: var(--ink-soft); font-size: .98rem; max-width: 34ch; }
  .sl-page .dur-cards { flex: 2 1 440px; display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; }
  .sl-page .dur {
    border: 1px solid var(--line); border-radius: 18px; padding: 26px 20px;
    background: color-mix(in oklab, var(--bg-raised), transparent 30%);
    text-align: center; transition: transform .4s var(--ease), border-color .4s, background .4s;
  }
  .sl-page .dur:hover { transform: translateY(-4px); border-color: var(--accent); background: var(--bg-raised); }
  .sl-page .dur .t { font-family: var(--font-display); font-size: 2.4rem; line-height: 1; color: var(--ink); }
  .sl-page .dur .t span { font-size: 1rem; color: var(--ink-faint); font-family: var(--font-body); }
  .sl-page .dur .c { margin-top: 12px; font-size: .86rem; color: var(--ink-soft); line-height: 1.5; }

  @media (max-width: 760px) {
    .sl-page .days { grid-template-columns: repeat(2, 1fr); }
    .sl-page .dur-cards { grid-template-columns: 1fr; }
  }

  /* ════════════════════ LISTA DE ESPERA ════════════════════ */
  .sl-page .waitlist { padding: clamp(90px,12vw,160px) 0; text-align: center; }
  .sl-page .wait-inner { max-width: 560px; margin: 0 auto; }
  .sl-page .wait-mandala { width: 92px; height: 92px; margin: 0 auto 28px; animation: slSpin calc(var(--spin) * .8) linear infinite; opacity: .95; }
  .sl-page .waitlist h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(2.1rem,4.8vw,3.4rem); line-height: 1.1; letter-spacing: -.01em; }
  .sl-page .waitlist h2 em { color: var(--accent); font-style: italic; font-weight: 500; }
  .sl-page .waitlist .lead { margin: 22px auto 0; max-width: 44ch; }

  .sl-page .wl-form { margin-top: 40px; display: flex; flex-direction: column; gap: 14px; text-align: left; }
  .sl-page .field label { display: block; font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 8px; font-weight: 600; }
  .sl-page .field .optional { text-transform: none; letter-spacing: 0; color: var(--ink-faint); font-weight: 400; }
  .sl-page .field input, .sl-page .field select {
