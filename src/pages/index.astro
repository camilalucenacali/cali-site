---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import PaymentModal from '../components/PaymentModal.astro';
import { workshops } from '../data/workshops.js';
import { getCollection } from 'astro:content';

const nextWorkshops = workshops.filter(w => w.status === 'upcoming' || w.status === 'tbd').slice(0, 3);
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const waUrl = `https://wa.me/5551999595522?text=${encodeURIComponent('Olá Cami! Quero saber mais sobre as imersões CALI.')}`;

const spine = [
  { time: '15 min', title: 'Abertura',        desc: 'Chegança real. Não começa com movimento — começa com parada. Dirga Pranayama, Sankalpa, Om × 3.' },
  { time: '20 min', title: 'Aquecimento',      desc: 'A coluna se move em 6 direções. A maioria das pessoas usa 1. Gato-vaca, torções, Surya Namaskar lento.' },
  { time: '40 min', title: 'Prática Central',  desc: 'Progressão clássica de pé → chão. Força, enraizamento, mobilidade profunda, introspecção.' },
  { time: '20 min', title: 'Nauli',            desc: 'O coração do Spine Lab. Shatkarma — prática de purificação do Hatha Yoga. Não é acrobacia: é medicina interna.', feature: true },
  { time: '15 min', title: 'Invertidas',       desc: 'Progressão segura: Viparita Karani, Sarvangasana, Sirsasana. Todo mundo entra de alguma forma.' },
  { time: '10 min', title: 'Encerramento',     desc: '7 minutos reais de Savasana — não negociável. Yoga Nidra breve. Círculo de fechamento.' },
];
---

<BaseLayout
  title="CALI MOVIMIENTO — Yoga, Dança e Movimento com Camila Lucena"
  description="Experiências de movimento, yoga, dança e expressão corporal com Camila Lucena. Imersões presenciais em todo o Brasil e Europa."
>
  <Header />

  <!-- ══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <section id="hero">
    <div class="prism prism-strong" id="heroPrism"></div>
    <div class="hero-sun-wrap" aria-hidden="true">
      <img src="/assets/cali-sun.png" alt="" class="hero-sun-bg" />
    </div>
    <canvas class="prana-canvas" id="prana" aria-hidden="true"></canvas>
    <div class="hero-inner">
      <img src="/assets/cali-wordmark.png" alt="CALI" class="hero-word" id="heroWord" />
      <p class="hero-movimiento reveal" id="heroMovim">Movimiento · por Cami Lucena</p>
      <p class="hero-tagline reveal">O corpo não é um problema a resolver. É um território a habitar.</p>
      <div class="hero-cta reveal">
        <a href="#agendanomade" class="btn btn-primary btn-lg">Ver imersões</a>
        <a href="#sobre" class="btn btn-outline btn-lg">Conhecer a Cami</a>
      </div>
    </div>
    <div class="scroll-cue">
      <span>rolar</span>
      <span>↓</span>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       MANIFESTO
  ══════════════════════════════════════════ -->
  <section id="manifesto" class="section-pad">
    <div class="wrap">
      <p class="eyebrow reveal">Manifesto</p>
      <h2 class="manifesto-lead serif-it reveal">Cuidando da tua coluna — e do mundo que ela habita.</h2>
      <div class="manifesto-grid">
        <div class="mblock reveal">
          <span class="num">01</span>
          <h3>Consumo consciente como movimento</h3>
          <p>Escolher o que consumimos é um movimento político e corporal. É o que "entra" e o que "sustenta" o ritmo da vida. Se o objetivo é ativar o ser, a poluição — visual, sonora ou química — é um ruído que bloqueia essa ativação.</p>
        </div>
        <div class="mblock reveal">
          <span class="num">02</span>
          <h3>Ambientes que ativam o sentir</h3>
          <p>Para sentir o corpo, precisamos de ambientes menos sintéticos. Conectar a preservação ambiental ao prazer sensorial que a natureza proporciona — o cheiro da chuva, o calor do sol, o frescor da água. Se o corpo sente prazer na natureza, o cuidado se torna instintivo.</p>
        </div>
        <div class="mblock reveal">
          <span class="num">03</span>
          <h3>O pé na terra</h3>
          <p>O pé na terra ativa terminações nervosas que "avisam" o corpo que ele pertence àquele lugar. Pertencer é a base de qualquer prática real de autoconhecimento.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       IMERSÕES
  ══════════════════════════════════════════ -->
  <section id="agendanomade" class="section-pad">
    <div class="prism" id="prismImersoes"></div>
    <div class="wrap" style="position:relative;z-index:3;">
      <div class="agenda-head">
        <div>
          <p class="eyebrow reveal">Agenda nômade</p>
          <h2 class="section-title reveal">Próximas imersões<br />presenciais</h2>
        </div>
        <p class="reveal" style="max-width:30ch;color:var(--ink-soft);">Camila leva o Spine Lab de cidade em cidade. Reserve seu lugar — vagas limitadas por turma.</p>
      </div>
      <div class="card-grid">
        {nextWorkshops.map((w, i) => {
          const isTbd = w.status === 'tbd';
          return (
            <article
              class="wcard reveal imersao-card"
              data-event-date={w.date ?? ''}
              data-early={w.currency==='EUR' ? w.priceEUR?.earlyBird : w.priceBRL?.earlyBird}
              data-regular={w.currency==='EUR' ? w.priceEUR?.regular : w.priceBRL?.regular}
              data-dayof={w.currency==='EUR' ? w.priceEUR?.dayOf : w.priceBRL?.dayOf}
              data-currency={w.currency}
              data-addon-price={w.addOn?.price ?? ''}
              data-addon-label={w.addOn?.label ?? ''}
              style={`transition-delay:${i*0.12}s`}
            >
              {isTbd && <span class="badge-tbd">Em breve</span>}
              <span class="w-date">{w.dateDisplay}</span>
              <span class="w-city">{w.neighborhood || w.city}</span>
              <span class="w-loc">{w.location}</span>
              <span class="w-time">⏰ {w.time}</span>
              <span class="w-chip tier-label"></span>
              <span class="w-price"><b class="tier-price"></b> <span class="pix tier-pix"></span></span>
              {w.addOn && <span style="font-size:0.8rem;color:var(--ink-soft);">🍱 Opcional: {w.addOn.label} — R${w.addOn.price}</span>}
              <button
                class="btn btn-primary"
                data-workshop={`${w.city}${w.neighborhood?' — '+w.neighborhood:''} · ${w.dateDisplay} ${w.time}`}
                data-price={w.currency==='EUR' ? w.priceEUR?.earlyBird : w.priceBRL?.earlyBird}
                data-currency={w.currency}
                data-addon-price={w.addOn?.price ?? ''}
                data-addon-label={w.addOn?.label ?? ''}
                disabled={isTbd}
                style={isTbd?'opacity:0.5;':''}
              >
                {isTbd ? 'Em breve — aguarde' : 'Reservar lugar'}
              </button>
            </article>
          );
        })}
      </div>
      <!-- Card vida nômade -->
      <div class="card-grid" style="margin-top:1.5rem;">
        <a href="/vida-nomade" class="wcard wcard-nomade reveal" style="text-decoration:none;">
          <span class="w-date" style="font-size:1.4rem;">✦</span>
          <span class="w-city">PRÓXIMOS WORKSHOPS</span>
          <span class="w-loc">aonde nos encontraremos?</span>
          <span class="w-time" style="margin-top:auto;">saber mais →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SOBRE A CAMI
  ══════════════════════════════════════════ -->
  <section id="sobre" class="section-pad">
    <div class="wrap">
      <div class="about-grid">
        <div class="portrait reveal">
          <img src="/fotos/Cami-18.jpg" alt="Camila Lucena" style="width:100%;height:100%;object-fit:cover;" />
        </div>
        <div class="about-copy">
          <p class="eyebrow reveal">Quem é</p>
          <h2 class="section-title reveal" style="margin-bottom:1.4rem;">a Cami</h2>
          <p class="reveal">Ativista do sentir corporal livre, a Cami é facilitadora de transformação pessoal e coletiva que funde saberes os quais muitas vezes transcendem a abordagem tradicional — oferecendo <strong>conexão, liberdade e autonomia</strong>. Propondo o cuidado como uma performance coletiva.</p>
          <p class="reveal">A relação da Cami com o corpo começou muito antes da prática. Aos 4 anos com o ballet, pra parar de tropeçar, deu certo! Natação, futsal, ginástica olímpica, judô.. e aos 11 anos, uma escoliose grave a apresentou à dor — e também à descoberta de que o movimento poderia ser resposta, não fuga.</p>

          <!-- Continuar lendo -->
          <div class="cami-expand reveal">
            <button class="btn btn-outline btn-cami-expand" id="btnCamiExpand" aria-expanded="false">
              Continuar lendo ↓
            </button>
            <div class="cami-more" id="camiMore" hidden>
              <p>Formada em engenharia civil, geminiana, praticante de yoga há 21 anos — a prática entrou na vida dela antes mesmo de qualquer formação. Em 2019, aos 29 anos, foi aprofundar essa relação na escola Kashish Yoga, baseada na Índia, onde se formou professora. O caminho seguiu: nove meses morando no Ashram Ram Das Guru, em Portugal, praticando sevadara na agrofloresta local. Depois, vivências no Ashram in the City, em Bruxelas. E, pelo mundo inteiro, ensinando e aprendendo — em trocas com culturas que expandiram o que ela entendia ser possível num corpo.</p>
              <p style="margin-top:1rem;">Desde 2023 ensina. Não um método — uma intenção.</p>
              <p style="margin-top:1rem;">Se queres entender melhor sobre ti mesma, tuas fases e ciclos — chegaste no lugar certo. Na aula conseguimos entrar em todos esses temas de uma forma leve e descontraída, mas profunda o suficiente para te auxiliar no teu autoconhecimento e autodescoberta. E quanto mais nos conhecemos, mais honramos a nossa vida — e entendemos os rumos que queremos e podemos dar a ela.</p>
            </div>
          </div>

          <div class="about-actions reveal">
            <a href={waUrl} target="_blank" rel="noopener" class="btn btn-outline">Conversar no WhatsApp</a>
            <a href="/vida-nomade" class="btn btn-primary">Ver imersões</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       1ª AULA ONLINE
  ══════════════════════════════════════════ -->
  <section id="aula" class="section-pad">
    <div class="prism" id="prismAula"></div>
    <div class="wrap">
      <div class="aula">
        <p class="eyebrow reveal">Experiência individual</p>
        <h2 class="section-title reveal" style="margin-bottom:1rem;">Marque tua 1ª aula online</h2>
        <p class="reveal" style="color:var(--ink-soft);max-width:46ch;margin-inline:auto;">
          Uma sessão de 35min, ao vivo via Zoom. A mesma inspirada nas imersões presenciais — no teu ritmo, no teu espaço.
        </p>
        <p class="price reveal" id="aulaPrice">R$ 45,00</p>
        <p class="reveal serif-it" style="color:var(--ink-soft);margin-top:-0.5rem;margin-bottom:1rem;">pra tua aula experimental</p>
        <a href="https://calendly.com/camilalucena-cali" target="_blank" rel="noopener" class="btn btn-primary btn-lg reveal" id="btnAgendar">📅 Agendar agora</a>
        <p class="reveal" style="color:var(--ink-soft);font-size:0.84rem;margin-top:1rem;">
          Escolhe a data e o horário que funcionam para ti — confirmação imediata.
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SPINE LAB — A PRÁTICA
  ══════════════════════════════════════════ -->
  <section id="pratica" class="section-pad">
    <div class="wrap">
      <p class="eyebrow reveal" style="text-align:center;">A prática</p>
      <h2 class="section-title reveal" style="text-align:center;">Spine Lab — 2 horas</h2>
      <p class="reveal serif-it" style="text-align:center;font-size:clamp(1.2rem,1rem+1.4vw,1.9rem);color:var(--ink-soft);margin-top:0.8rem;">
        Para quem quer sentir o corpo cada vez mais como lar.
      </p>
      <div class="spine-grid">
        {spine.map((s, i) => (
          <div
            class={`sblock reveal${s.feature ? ' feature' : ''}`}
            style={`transition-delay:${i*0.1}s`}
          >
            <div class="sblock-foto" style={`background-image:url('/fotos/foto${i+1}.jpg')`}></div>
            <span class="s-time">{s.time}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       CTA FINAL
  ══════════════════════════════════════════ -->
  <section id="cta" class="section-pad">
    <div class="prism prism-strong" id="prismCta"></div>
    <div class="wrap">
      <div class="cta-final">
        <p class="eyebrow reveal">Próximo passo</p>
        <h2 class="reveal">Fico muito feliz que vamos nos encontrar em tempo real!</h2>
        <p class="reveal">Nossa prática pode acontecer de forma presencial ou online via Zoom, onde estarei inteiramente disposta e interessada em te entender e vivenciar contigo.</p>
        <p class="reveal">Podes tirar todas as dúvidas que quiseres — ou já partir direto para a reserva.</p>
        <div class="cta-actions reveal">
          <a href={waUrl} target="_blank" rel="noopener" class="btn btn-outline btn-lg">💬 Vamos ver</a>
          <a href="#agendanomade" class="btn btn-primary btn-lg">✨ Já quero</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       BLOG
  ══════════════════════════════════════════ -->
  {posts.length > 0 && (
    <section id="blog" class="section-pad">
      <div class="wrap">
        <p class="eyebrow reveal" style="text-align:center;">Blog</p>
        <h2 class="section-title reveal" style="text-align:center;margin-bottom:3rem;">Escritas do movimento</h2>
        <div class="blog-grid">
          {posts.map((post, i) => (
            <a href={`/blog/${post.slug}`} class="bcard reveal" style={`transition-delay:${i*0.12}s`}>
              <span class="b-meta">{post.data.pubDate.toLocaleDateString('pt-BR',{day:'2-digit',month:'long',year:'numeric'})} · {post.data.city}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="b-more">Ler o texto →</span>
            </a>
          ))}
        </div>
        <div style="text-align:center;margin-top:3rem;" class="reveal">
          <a href="/blog" class="btn btn-outline">Ver todos os textos</a>
        </div>
      </div>
    </section>
  )}

  <Footer />
  <WhatsAppButton />
  <PaymentModal />
</BaseLayout>

<script is:inline>
(function() {
  /* Detect timezone → price for 1ª aula */
  try {
    var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
    if (tz.startsWith('Europe/')) {
      var p = document.getElementById('aulaPrice');
      if (p) p.textContent = '€ 45,00';
    }
  } catch(e) {}

  /* Dynamic pricing in home cards */
  function getTier(dateStr) {
    if (!dateStr) return 'earlyBird';
    var today = new Date(); today.setHours(0,0,0,0);
    var ev    = new Date(dateStr + 'T00:00:00');
    var days  = Math.floor((ev - today) / 86400000);
    return days >= 3 ? 'earlyBird' : days <= 0 ? 'dayOf' : 'regular';
  }
  var LABELS = { earlyBird: '🐦 Early bird', regular: 'Regular', dayOf: 'No dia' };

  document.querySelectorAll('.imersao-card').forEach(function(card) {
    var early   = parseFloat(card.dataset.early   || 0);
    var regular = parseFloat(card.dataset.regular || 0);
    var dayof   = parseFloat(card.dataset.dayof   || 0);
    var cur     = card.dataset.currency === 'EUR' ? '€' : 'R$';
    var tier    = getTier(card.dataset.eventDate || null);
    var price   = {earlyBird:early,regular:regular,dayOf:dayof}[tier] || early;
    var pix     = Math.round(price*0.9*100)/100;
    var fmt     = function(v){ return cur+v.toFixed(2).replace('.',','); };

    var lbl  = card.querySelector('.tier-label');
    var prEl = card.querySelector('.tier-price');
    var pixEl= card.querySelector('.tier-pix');
    var btn  = card.querySelector('[data-workshop]');

    if (lbl)  lbl.textContent  = LABELS[tier] || '';
    if (prEl) prEl.textContent = fmt(price);
    if (pixEl)pixEl.textContent= '· '+fmt(pix)+' PIX';
    if (btn && card.dataset.eventDate) btn.dataset.price = price;
  });
})();
</script>

<!-- Hero FX: prana particles + mouse gravity -->
<script is:inline>
/* ============================================================
   CALI — Hero FX  (prana particles + mouse gravity)
   ============================================================ */
(function () {
  "use strict";
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var canvas = document.getElementById("prana");
  var hero   = document.getElementById("hero");
  if (canvas && hero) {
    var ctx = canvas.getContext("2d");
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var W = 0, H = 0, particles = [];
    var PALETTE = [[255,122,46],[255,122,46],[232,188,99],[255,168,92],[251,176,215],[102,207,190],[111,194,220],[195,174,201]];
    function resize(){ var r=hero.getBoundingClientRect(); W=r.width; H=r.height; canvas.width=Math.round(W*dpr); canvas.height=Math.round(H*dpr); canvas.style.width=W+"px"; canvas.style.height=H+"px"; ctx.setTransform(dpr,0,0,dpr,0,0); }
    function makeParticle(initial){ var col=PALETTE[(Math.random()*PALETTE.length)|0]; return {baseX:Math.random()*W,y:initial?Math.random()*H:H+Math.random()*40,vy:8+Math.random()*16,amp:10+Math.random()*46,ampGrow:0.15+Math.random()*0.5,freq:0.28+Math.random()*0.7,phase:Math.random()*Math.PI*2,size:1.0+Math.random()*2.3,col:col,twPhase:Math.random()*Math.PI*2,twFreq:0.7+Math.random()*1.7,baseAlpha:0.5+Math.random()*0.5,star:Math.random()<0.22,age:0,life:9+Math.random()*9}; }
    function reset(p){ var np=makeParticle(false); for(var k in np) p[k]=np[k]; }
    function spawn(){ particles=[]; var count=Math.max(30,Math.min(84,Math.round(W*H/18000))); for(var i=0;i<count;i++) particles.push(makeParticle(true)); }
    function draw(p){ var t=p.age,climb=1-p.y/(H+1),amp=p.amp*(1+p.ampGrow*climb),x=p.baseX+Math.sin(p.phase+t*p.freq*Math.PI*2)*amp; var fadeIn=Math.min(1,t*1.4),fadeOut=Math.min(1,(p.life-t)*0.7,p.y/(H*0.22)),twinkle=0.55+0.45*Math.sin(p.twPhase+t*p.twFreq*Math.PI*2),a=p.baseAlpha*twinkle*fadeIn*Math.max(0,fadeOut); if(a<=0.01) return; var c=p.col,size=p.size*(0.85+0.3*twinkle),halo=size*6,g=ctx.createRadialGradient(x,p.y,0,x,p.y,halo); g.addColorStop(0,"rgba("+c[0]+","+c[1]+","+c[2]+","+(a*0.5)+")"); g.addColorStop(0.4,"rgba("+c[0]+","+c[1]+","+c[2]+","+(a*0.18)+")"); g.addColorStop(1,"rgba("+c[0]+","+c[1]+","+c[2]+",0)"); ctx.fillStyle=g; ctx.beginPath(); ctx.arc(x,p.y,halo,0,Math.PI*2); ctx.fill(); ctx.fillStyle="rgba(255,248,240,"+Math.min(1,a*0.9)+")"; ctx.beginPath(); ctx.arc(x,p.y,size*0.65,0,Math.PI*2); ctx.fill(); ctx.fillStyle="rgba("+c[0]+","+c[1]+","+c[2]+","+a+")"; ctx.beginPath(); ctx.arc(x,p.y,size,0,Math.PI*2); ctx.fill(); if(p.star){ ctx.strokeStyle="rgba("+c[0]+","+c[1]+","+c[2]+","+(a*0.7)+")"; ctx.lineWidth=0.8; var ray=size*3.4*(0.7+0.5*twinkle); ctx.beginPath(); ctx.moveTo(x-ray,p.y); ctx.lineTo(x+ray,p.y); ctx.moveTo(x,p.y-ray); ctx.lineTo(x,p.y+ray); ctx.stroke(); } }
    var last=performance.now(),running=true;
    function frame(now){ if(!running) return; var dt=Math.min((now-last)/1000,0.05); last=now; ctx.clearRect(0,0,W,H); for(var i=0;i<particles.length;i++){ var p=particles[i]; p.age+=dt; p.y-=p.vy*dt; if(p.y<-20||p.age>p.life) reset(p); draw(p); } requestAnimationFrame(frame); }
    resize(); spawn();
    if (!reduce) requestAnimationFrame(frame);
    else for(var i=0;i<particles.length;i++){ particles[i].age=2; draw(particles[i]); }
    var rT; window.addEventListener("resize",function(){ clearTimeout(rT); rT=setTimeout(function(){ resize(); spawn(); },200); });
    if ("IntersectionObserver" in window && !reduce) new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting&&!running){running=true;last=performance.now();requestAnimationFrame(frame);}else if(!e.isIntersecting){running=false;} }); },{threshold:0}).observe(hero);
  }
  var word=document.getElementById("heroWord"),movim=document.getElementById("heroMovim");
  if (word && hero && !reduce && window.gsap) {
    var wx=gsap.quickTo(word,"x",{duration:0.9,ease:"power3"}),wy=gsap.quickTo(word,"y",{duration:0.9,ease:"power3"}),wr=gsap.quickTo(word,"rotation",{duration:1.1,ease:"power3"});
    var mx=movim?gsap.quickTo(movim,"x",{duration:1.1,ease:"power3"}):null,my=movim?gsap.quickTo(movim,"y",{duration:1.1,ease:"power3"}):null;
    hero.addEventListener("mousemove",function(e){ var r=hero.getBoundingClientRect(),nx=Math.max(-1,Math.min(1,(e.clientX-(r.left+r.width/2))/(r.width/2))),ny=Math.max(-1,Math.min(1,(e.clientY-(r.top+r.height/2))/(r.height/2))); wx(nx*34);wy(ny*22);wr(nx*3.2); if(mx){mx(nx*18);my(ny*12);} });
    hero.addEventListener("mouseleave",function(){ wx(0);wy(0);wr(0); if(mx){mx(0);my(0);} });
  }
})();
</script>

<!-- Hero GSAP entrance -->
<script is:inline>
(function() {
  if (!window.gsap) return;
  var R = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (R) return;

  function splitChars(el) {
    var text = el.textContent;
    el.textContent = '';
    return text.split('').map(function(ch) {
      var s = document.createElement('span');
      s.className = 'ltr';
      s.textContent = ch === ' ' ? ' ' : ch;
      el.appendChild(s);
      return s;
    });
  }

  var heroWord = document.getElementById('heroWord');
  var movim    = document.getElementById('heroMovim');
  var tagline  = document.querySelector('.hero-tagline');
  var heroCta  = document.querySelector('.hero-cta');
  var movChars = movim ? splitChars(movim) : [];

  var tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
  tl.from(heroWord, { opacity:0, scale:0.86, filter:'blur(8px)', duration:1.1, ease:'power4.out' }, 0.2)
    .from(movChars, { opacity:0, y:24, duration:0.6, stagger:0.045 }, 0.5)
    .from(tagline,  { opacity:0, y:30, duration:0.9 }, 0.8)
    .from(heroCta,  { opacity:0, y:20, duration:0.7 }, 1.05);

  /* Prism parallax */
  if (window.ScrollTrigger) {
    document.querySelectorAll('[id^="prism"]').forEach(function(p) {
      gsap.fromTo(p,{yPercent:-6},{yPercent:6,ease:'none',
        scrollTrigger:{trigger:p.parentElement,start:'top bottom',end:'bottom top',scrub:true}});
    });
    /* Prism intensity on scroll velocity */
    var target=1,current=1;
    ScrollTrigger.create({ onUpdate: function(self) {
      var v=Math.min(Math.abs(self.getVelocity())/2600,1); target=1+v*0.7;
    }});
    gsap.ticker.add(function() {
      current+=(target-current)*0.06; target+=(1-target)*0.05;
      document.documentElement.style.setProperty('--prism-intensity',current.toFixed(3));
    });
  }
})();
</script>

<style>
  /* Hover foto nos cards Spine Lab */
  .sblock { position: relative; overflow: hidden; }
  .sblock-foto {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 0.45s ease;
    border-radius: 18px;
    z-index: 1;
  }
  .sblock:hover .sblock-foto { opacity: 1; }
  .sblock .s-time,
  .sblock h3,
  .sblock p { position: relative; z-index: 2; }
</style>
