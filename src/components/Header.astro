---
const links = [
  { label: 'Imersões',      href: '/#pratica' },
  { label: 'Vida Nômade',   href: '/vida-nomade' },
  { label: 'APP Spine Lab', href: '/app-spine-lab' },
  { label: 'Blog',          href: '/blog' },
];
---
<header class="site-header" id="header">
  <a href="/" class="brand" aria-label="CALI — início">
    <img src="/assets/cali-sun.png" alt="" class="brand-sun" />
    <img src="/assets/cali-wordmark.png" alt="CALI" />
  </a>

  <nav class="nav-main" id="nav">
    {links.map(l => <a href={l.href}>{l.label}</a>)}
    <a href="/#agendanomade" class="nav-cta">Reservar lugar</a>
  </nav>

  <button class="nav-toggle" id="navToggle" aria-label="Menu">☰</button>
</header>
