---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { getCollection } from 'astro:content';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.pubDate.toISOString(),
  "author": { "@type": "Person", "name": "Camila Lucena" },
  "publisher": { "@type": "Organization", "name": "CALI MOVIMIENTO" }
};
---

<BaseLayout
  title={`${post.data.title} — CALI MOVIMIENTO`}
  description={post.data.description}
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />

  <Header />

  <section class="article-head section-pad page-top">
    <div class="prism" id="prismArticle"></div>
    <div class="wrap">
      <a href="/blog" class="back-link">← Voltar ao blog</a>
      <p class="article-meta">
        {post.data.pubDate.toLocaleDateString('pt-BR', { day:'2-digit', month:'long', year:'numeric' })}
        {post.data.city && <span> · {post.data.city}</span>}
      </p>
      <h1>{post.data.title}</h1>
      <p class="article-dek">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <div class="article-tags">
          {post.data.tags.map(tag => <span>{tag}</span>)}
        </div>
      )}
    </div>
  </section>

  <div class="wrap">
    <div class="prose">
      <Content />
    </div>

    <div class="article-cta">
      <h3>Gostaste? Encontra-me numa imersão.</h3>
      <p>A prática acontece ao vivo — presencial ou online. Vagas limitadas por turma.</p>
      <div class="cta-actions">
        <a href="/imersoes" class="btn btn-primary">Ver imersões</a>
        <a href="/blog" class="btn btn-outline">← Mais textos</a>
      </div>
    </div>
  </div>

  <Footer />
  <WhatsAppButton />
</BaseLayout>

<script is:inline>
(function() {
  if (!window.gsap || !window.ScrollTrigger) return;
  var p = document.getElementById('prismArticle');
  if (p) gsap.fromTo(p,{yPercent:-6},{yPercent:6,ease:'none',
    scrollTrigger:{trigger:p.parentElement,start:'top bottom',end:'bottom top',scrub:true}});
})();
</script>
