---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

const appUrl  = 'https://calispinelab.vercel.app';
const waUrl   = `https://wa.me/5551999595522?text=${encodeURIComponent('Olá! Me inscrevi na lista da Spine Lab e gostaria de agendar minha conversa de 15 min com a Camila.')}`;

const days = [
  { n: '01', role: 'Compreender', desc: 'Introdução teórica e a experiência inicial — o que vai acontecer e por quê.' },
  { n: '02', role: 'Praticar',    desc: 'Prática mais intensa e consistente — para consolidar o que foi apresentado.' },
  { n: '03', role: 'Integrar',    desc: 'Meditação orientada para o tema da fase — levar o aprendizado para o interno.' },
  { n: '04', role: 'Assimilar',   desc: 'Savasana guiado — corpo e mente absorvem o que foi aprendido.' },
];

const durations = [
  { min: '5',  desc: 'Versão concisa e direta, para os dias de pouco tempo.' },
  { min: '10', desc: 'Inclui asanas básicos para o bem-estar do corpo.' },
  { min: '21', desc: 'Mini prática de Hatha completa, para ir mais fundo.' },
];
---

<BaseLayout
  title="APP Spine Lab — CALI MOVIMIENTO"
  description="O Spine Lab está em fase beta. Uma jornada de respiração consciente e movimento da coluna — acesso via conversa com a Cami."
>
  <Header />

  <!-- ══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <section class="sl-hero" id="hero">

    <!-- mandala animada -->
    <div class="sl-mandala-wrap" aria-hidden="true">
      <svg class="sl-mandala" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="sl-grad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%"   stop-color="#FF7F5C"/>
            <stop offset="50%"  stop-color="#FF4D9F"/>
            <stop offset="100%" stop-color="#8B9FFF"/>
          </linearGradient>
        </defs>
        <g transform="translate(100,100)" fill="none" stroke="url(#sl-grad)" stroke-width="1.1">
          <circle r="10"/>
          <circle r="20"/>
          <circle r="31"/>
          <circle r="44"/>
          <circle r="58"/>
          <ellipse rx="7"  ry="24" transform="rotate(0)"/>
          <ellipse rx="7"  ry="24" transform="rotate(45)"/>
          <ellipse rx="7"  ry="24" transform="rotate(90)"/>
          <ellipse rx="7"  ry="24" transform="rotate(135)"/>
          <ellipse rx="12" ry="40" transform="rotate(22.5)"/>
          <ellipse rx="12" ry="40" transform="rotate(67.5)"/>
        </g>
      </svg>
      <svg class="sl-mandala sl-mandala-halo" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="sl-grad2" x1="1" y1="1" x2="0" y2="0">
            <stop offset="0%"   stop-color="#FF7F5C" stop-opacity="0.3"/>
            <stop offset="100%" stop-color="#8B9FFF" stop-opacity="0.1"/>
          </linearGradient>
        </defs>
        <g transform="translate(100,100)" fill="none" stroke="url(#sl-grad2)" stroke-width="0.8">
          <circle r="70"/>
          <circle r="82"/>
          <ellipse rx="16" ry="56" transform="rotate(15)"/>
          <ellipse rx="16" ry="56" transform="rotate(75)"/>
          <ellipse rx="16" ry="56" transform="rotate(135)"/>
        </g>
      </svg>
    </div>

    <div class="sl-hero-inner reveal">
      <p class="sl-eyebrow">Respiração <span class="sl-dot">·</span> Coluna</p>
      <h1 class="sl-h1">
        A sua jornada.<br>
        <em>O seu ritmo.</em><br>
        O seu corpo.
      </h1>
      <p class="sl-lead">
        Uma prática diária de respiração e movimento com raiz nos Yoga Sutras de Patanjali — organizada em ciclos de 28 dias que cabem em 5, 10 ou 21 minutos.
      </p>

      <div class="sl-live">
        <span class="sl-live-dot"></span>
        <span>10 conversas por semana · próxima liberação: segunda-feira</span>
      </div>

      <div class="sl-hero-cta">
        <a href="#lista" class="btn btn-primary btn-lg">
          Entrar na lista de espera <span class="sl-arr">→</span>
        </a>
        <a href={appUrl} target="_blank" rel="noopener" class="btn btn-outline btn-lg">
          Experimentar Fase 1 ↗
        </a>
      </div>
    </div>

    <div class="sl-scroll-cue">
      <span class="sl-scroll-line"></span>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       MANIFESTO
  ══════════════════════════════════════════ -->
  <section class="sl-manifesto" id="manifesto">
    <div class="wrap">
      <p class="sl-eyebrow reveal" style="text-align:center;">Manifesto Spine Lab</p>
      <blockquote class="sl-quote reveal">
        Acreditamos que o corpo sabe o caminho.<br>
        E que <em>cinco minutos</em> de presença real valem mais<br class="sl-br"> que uma hora de distração.
      </blockquote>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       COMO FUNCIONA
  ══════════════════════════════════════════ -->
  <section class="sl-how section-pad" id="como-funciona">
    <div class="wrap">

      <div class="sl-how-head">
        <p class="sl-eyebrow reveal">Como funciona</p>
        <h2 class="sl-h2 reveal">Uma jornada, <em>não um catálogo.</em></h2>
        <p class="sl-p reveal">
          Cada aula prepara a próxima. Cada fase aprofunda a anterior. Cada ciclo de 28 dias marca uma transformação concreta — sem pular, e isso não é limitação, é design.
        </p>
      </div>

      <!-- equação -->
      <div class="sl-eq reveal">
        <div class="sl-eq-item"><span class="sl-eq-num">1</span><span class="sl-eq-lbl">Ciclo</span></div>
        <span class="sl-eq-op">×</span>
        <div class="sl-eq-item"><span class="sl-eq-num">7</span><span class="sl-eq-lbl">Fases</span></div>
        <span class="sl-eq-op">×</span>
        <div class="sl-eq-item"><span class="sl-eq-num">4</span><span class="sl-eq-lbl">Dias</span></div>
        <span class="sl-eq-op">=</span>
        <div class="sl-eq-item sl-eq-result"><span class="sl-eq-num">28</span><span class="sl-eq-lbl">Dias de prática</span></div>
      </div>

      <!-- 4 dias -->
      <div class="sl-days">
        {days.map((d, i) => (
          <div class="sl-day reveal" style={`transition-delay:${i*0.1}s`}>
            <div class="sl-day-num">{d.n}</div>
            <div class="sl-day-role">{d.role}</div>
            <p class="sl-day-desc">{d.desc}</p>
          </div>
        ))}
      </div>

      <!-- durações -->
      <div class="sl-dur-wrap">
        <div class="sl-dur-head reveal">
          <h3 class="sl-h3">A mesma prática, na medida do seu dia.</h3>
          <p class="sl-p">Cada aula existe em três durações que passam o mesmo conhecimento — escolha conforme o tempo e a energia disponíveis.</p>
        </div>
        <div class="sl-durs">
          {durations.map((d, i) => (
            <div class="sl-dur reveal" style={`transition-delay:${i*0.12}s`}>
              <div class="sl-dur-min">{d.min}<span> min</span></div>
              <p class="sl-dur-desc">{d.desc}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════
       LISTA DE ESPERA
  ══════════════════════════════════════════ -->
  <section class="sl-waitlist section-pad" id="lista">
    <div class="wrap sl-wl-wrap">

      <div class="sl-mandala-sm" aria-hidden="true">
        <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="sl-grad3" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%"   stop-color="#FF7F5C"/>
              <stop offset="50%"  stop-color="#FF4D9F"/>
              <stop offset="100%" stop-color="#8B9FFF"/>
            </linearGradient>
          </defs>
          <g transform="translate(60,60)" fill="none" stroke="url(#sl-grad3)" stroke-width="1.2">
            <circle r="8"/><circle r="16"/><circle r="26"/>
            <ellipse rx="5" ry="18" transform="rotate(0)"/>
            <ellipse rx="5" ry="18" transform="rotate(60)"/>
            <ellipse rx="5" ry="18" transform="rotate(120)"/>
          </g>
        </svg>
      </div>

      <p class="sl-eyebrow reveal" style="text-align:center;">Lista de espera</p>
      <h2 class="sl-h2 reveal" style="text-align:center;">O acesso começa<br><em>com uma conversa.</em></h2>
      <p class="sl-p reveal" style="text-align:center;max-width:48ch;margin-inline:auto;">
        O acesso à Spine Lab começa com uma conversa de 15 min com a Cami — são 10 vagas por semana. Deixe seu contato e a gente abre o WhatsApp para agendar.
      </p>

      <form class="sl-form reveal" id="wlForm" novalidate>
        <div class="sl-field">
          <label for="wl-nome">Nome</label>
          <input type="text" id="wl-nome" name="nome" autocomplete="given-name" placeholder="Teu nome" required />
          <span class="sl-err">Conta pra gente seu nome.</span>
        </div>
        <div class="sl-field">
          <label for="wl-email">E-mail</label>
          <input type="email" id="wl-email" name="email" autocomplete="email" placeholder="teu@email.com" required />
          <span class="sl-err">Confere o e-mail, parece incompleto.</span>
        </div>
        <div class="sl-field">
          <label for="wl-obj">Objetivo <span class="sl-optional">(opcional)</span></label>
          <select id="wl-obj" name="objetivo">
            <option value="">Escolha uma opção</option>
            <option>Dor nas costas ou no pescoço</option>
            <option>Ansiedade e clareza mental</option>
            <option>Quero mais consistência</option>
            <option>Curiosidade sobre a prática</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary sl-submit">
          Entrar na lista <span class="sl-arr">→</span>
        </button>
        <p class="sl-fine">Sem spam. Abrimos o WhatsApp da Cami para agendar sua conversa.</p>
      </form>

      <div class="sl-success" id="wlSuccess" style="display:none;">
        <div class="sl-success-icon">
          <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="20" cy="20" r="20" fill="url(#sg)"/>
            <path d="M11 21l6 6L29 14" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <defs>
              <linearGradient id="sg" x1="0" y1="0" x2="1" y2="1">
                <stop stop-color="#FF7F5C"/><stop offset="0.5" stop-color="#FF4D9F"/><stop offset="1" stop-color="#8B9FFF"/>
              </linearGradient>
            </defs>
          </svg>
        </div>
        <h3>Você está na lista.</h3>
        <p id="wlSuccessMsg">A Cami vai abrir o WhatsApp para agendar sua conversa.</p>
      </div>

    </div>
  </section>

  <Footer />
  <WhatsAppButton text="Olá! Quero saber mais sobre o Spine Lab e entrar na lista de espera." />
</BaseLayout>

<script is:inline>
(function() {
  var form    = document.getElementById('wlForm');
  var success = document.getElementById('wlSuccess');
  var msg     = document.getElementById('wlSuccessMsg');
  if (!form) return;

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var nome   = document.getElementById('wl-nome');
    var email  = document.getElementById('wl-email');
    var obj    = document.getElementById('wl-obj');
    var valid  = true;

    form.querySelectorAll('.sl-field').forEach(function(f) { f.classList.remove('sl-error'); });

    if (!nome.value.trim()) { nome.closest('.sl-field').classList.add('sl-error'); valid = false; }
    if (!email.value.trim() || !email.value.includes('@')) { email.closest('.sl-field').classList.add('sl-error'); valid = false; }
    if (!valid) return;

    var text  = 'Olá Cami! Me chamo ' + nome.value.trim() + ', meu e-mail é ' + email.value.trim();
    if (obj.value) text += '. Objetivo: ' + obj.value;
    text += '. Me inscrevi na lista da Spine Lab e gostaria de agendar minha conversa de 15 min.';

    var waUrl = 'https://wa.me/5551999595522?text=' + encodeURIComponent(text);
    window.open(waUrl, '_blank');

    form.style.display = 'none';
    success.style.display = 'block';
    msg.textContent = 'Abrindo o WhatsApp da Cami para agendar a tua conversa.';
  });
})();
</script>

<style>
  /* ── Variáveis específicas Spine Lab ─────────── */
  :root {
    --sl-coral:    #FF7F5C;
    --sl-magenta:  #FF4D9F;
    --sl-lavender: #8B9FFF;
    --sl-sage:     #5A7F6F;
    --sl-grad:     linear-gradient(135deg, #FF7F5C 0%, #FF4D9F 50%, #8B9FFF 100%);
    --sl-bg-deep:  #ECE6DB;
    --sl-line:     #E2DACB;
    --sl-ink:      #322A33;
    --sl-ink-soft: #6E6570;
  }

  /* ── HERO ─────────────────────────────────────── */
  .sl-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 8rem var(--gut) 7rem;
    overflow: hidden;
    background: var(--paper);
  }

  .sl-mandala-wrap {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 0;
  }
  .sl-mandala {
    width: min(500px, 80vw);
    height: auto;
    position: absolute;
    animation: slSpin 140s linear infinite;
    opacity: 0.8;
  }
  .sl-mandala-halo {
    width: min(640px, 95vw);
    animation-direction: reverse;
    animation-duration: 220s;
    opacity: 0.5;
  }
  @keyframes slSpin { to { transform: rotate(360deg); } }

  .sl-hero-inner {
    position: relative;
    z-index: 2;
    max-width: 780px;
  }

  .sl-eyebrow {
    font-family: var(--font-body);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: var(--sl-coral);
    margin-bottom: 1.4rem;
    display: block;
  }
  .sl-dot { color: var(--sl-lavender); }

  .sl-h1 {
    font-family: var(--font-display);
    font-size: clamp(2.9rem, 7.2vw, 6.2rem);
    line-height: 1.03;
    letter-spacing: 0.005em;
    color: var(--sl-ink);
    margin-bottom: 1.4rem;
  }
  .sl-h1 em {
    font-family: var(--font-serif);
    font-style: italic;
    background: var(--sl-grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .sl-lead {
    font-size: clamp(1rem, 1.8vw, 1.18rem);
    line-height: 1.72;
    color: var(--sl-ink-soft);
    max-width: 54ch;
    margin: 0 auto 1.8rem;
  }

  .sl-live {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.83rem;
    color: var(--sl-ink-soft);
    margin-bottom: 2rem;
    letter-spacing: 0.02em;
  }
  .sl-live-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--sl-sage);
    box-shadow: 0 0 0 0 rgba(90,127,111,0.5);
    animation: slPulse 2.2s ease infinite;
    flex-shrink: 0;
  }
  @keyframes slPulse {
    0%   { box-shadow: 0 0 0 0 rgba(90,127,111,0.5); }
    70%  { box-shadow: 0 0 0 8px rgba(90,127,111,0); }
    100% { box-shadow: 0 0 0 0 rgba(90,127,111,0); }
  }

  .sl-hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .sl-arr { display: inline-block; transition: transform 0.3s ease; }
  .btn:hover .sl-arr { transform: translateX(4px); }

  .sl-scroll-cue {
    position: absolute;
    bottom: 2.2rem;
    left: 50%;
    translate: -50% 0;
    z-index: 2;
  }
  .sl-scroll-line {
    display: block;
    width: 1px;
    height: 52px;
    background: linear-gradient(to bottom, var(--sl-coral), transparent);
    margin: 0 auto;
    animation: slLine 2.4s ease infinite;
    transform-origin: top;
  }
  @keyframes slLine {
    0%   { transform: scaleY(0); opacity: 0; }
    30%  { opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }

  /* ── MANIFESTO ────────────────────────────────── */
  .sl-manifesto {
    padding: clamp(5rem, 9vw, 8rem) var(--gut);
    background: var(--sl-bg-deep);
    text-align: center;
  }
  .sl-quote {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 3rem);
    font-weight: 400;
    line-height: 1.28;
    color: var(--sl-ink);
    max-width: 22ch;
    margin: 1.2rem auto 0;
  }
  .sl-quote em {
    font-family: var(--font-serif);
    font-style: italic;
    background: var(--sl-grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .sl-br { display: none; }
  @media (min-width: 600px) { .sl-br { display: block; } }

  /* ── COMO FUNCIONA ────────────────────────────── */
  .sl-how { background: var(--paper); }
  .sl-how-head { max-width: 640px; margin-bottom: 3.5rem; }
  .sl-h2 {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.6vw, 3.5rem);
    line-height: 1.06;
    color: var(--sl-ink);
    margin: 0.6rem 0 1rem;
  }
  .sl-h2 em {
    font-family: var(--font-serif);
    font-style: italic;
    background: var(--sl-grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .sl-p { color: var(--sl-ink-soft); line-height: 1.72; font-size: 1.05rem; }
  .sl-h3 { font-family: var(--font-display); font-size: clamp(1.4rem, 2.8vw, 2rem); color: var(--sl-ink); margin-bottom: 0.7rem; }

  /* equação */
  .sl-eq {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 0 0 3.5rem;
    padding: 1.8rem 2rem;
    background: var(--sl-bg-deep);
    border-radius: 20px;
    border: 1px solid var(--sl-line);
  }
  .sl-eq-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    min-width: 4rem;
  }
  .sl-eq-num {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1;
    background: var(--sl-grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .sl-eq-lbl {
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--sl-ink-soft);
  }
  .sl-eq-op {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--sl-line);
    flex-shrink: 0;
  }
  .sl-eq-result .sl-eq-num { font-size: clamp(2.4rem, 5vw, 4rem); }

  /* 4 dias */
  .sl-days {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
    margin-bottom: 4rem;
  }
  .sl-day {
    padding: 1.6rem;
    border: 1px solid var(--sl-line);
    border-radius: 18px;
    background: rgba(255,255,255,0.6);
    position: relative;
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(.22,.61,.36,1), box-shadow 0.4s ease, border-color 0.4s;
  }
  .sl-day::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 3px;
    background: var(--sl-grad);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }
  .sl-day:hover { transform: translateY(-6px); box-shadow: 0 20px 44px -20px rgba(50,42,51,0.2); border-color: var(--sl-coral); }
  .sl-day:hover::after { transform: scaleX(1); }
  .sl-day-num {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    color: var(--sl-coral);
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }
  .sl-day-role { font-family: var(--font-display); font-size: 1.4rem; color: var(--sl-ink); margin-bottom: 0.7rem; }
  .sl-day-desc { font-size: 0.9rem; color: var(--sl-ink-soft); line-height: 1.65; margin: 0; }

  /* durações */
  .sl-dur-wrap {
    background: var(--sl-bg-deep);
    border-radius: 24px;
    border: 1px solid var(--sl-line);
    padding: clamp(1.8rem, 4vw, 3rem);
  }
  .sl-dur-head { margin-bottom: 2.2rem; max-width: 560px; }
  .sl-durs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }
  .sl-dur {
    background: rgba(255,255,255,0.55);
    border: 1px solid var(--sl-line);
    border-radius: 16px;
    padding: 1.4rem;
    transition: transform 0.35s ease, border-color 0.35s ease;
    text-align: center;
  }
  .sl-dur:hover { transform: translateY(-4px); border-color: var(--sl-coral); }
  .sl-dur-min {
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1;
    background: var(--sl-grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.6rem;
  }
  .sl-dur-min span { font-size: 1rem; }
  .sl-dur-desc { font-size: 0.88rem; color: var(--sl-ink-soft); line-height: 1.6; margin: 0; }

  /* ── LISTA DE ESPERA ─────────────────────────── */
  .sl-waitlist { background: var(--paper); }
  .sl-wl-wrap { max-width: 540px; text-align: center; }
