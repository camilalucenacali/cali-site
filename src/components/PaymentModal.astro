---
const pixKey   = '03043151097';
const waNumber = '5551999595522';
---

<div class="modal-overlay" id="payModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal">
    <button class="modal-close" id="modalClose" aria-label="Fechar">✕</button>

    <p class="eyebrow" style="text-align:center;margin-bottom:0.4rem;">Imersão CALI</p>
    <h2 id="modalTitle">Reservar lugar</h2>
    <p class="m-sub" id="modalSub"></p>

    <div id="addonSection" class="modal-addon" style="display:none;">
      <label style="display:flex;align-items:center;gap:0.8rem;cursor:pointer;">
        <input type="checkbox" id="addonCheck" style="width:18px;height:18px;accent-color:var(--orange);" />
        <span id="addonLabel" style="font-size:0.9rem;"></span>
      </label>
    </div>

    <div style="margin-bottom:1rem;">
      <div class="modal-coupon">
        <input type="text" id="couponInput" placeholder="Código de desconto" />
        <button id="couponApply">Aplicar</button>
      </div>
      <p id="couponMsg" style="font-size:0.78rem;min-height:1em;margin-top:0.3rem;"></p>
    </div>

    <div class="pix-box">
      <p class="pix-head">Pague com <b>PIX</b> e ganhe <b>10% de desconto</b></p>
      <p style="font-size:0.88rem;color:var(--ink-soft);margin-bottom:0.6rem;">
        Valor com desconto: <span class="pix-price" id="pixPrice"></span>
      </p>
      <div class="pix-key-box">
        <span class="pix-key">{pixKey}</span>
        <button class="copy-btn" id="copyBtn">Copiar chave</button>
      </div>
      <p class="steps">1. Copie a chave PIX &nbsp;·&nbsp; 2. Pague o valor com desconto &nbsp;·&nbsp; 3. Envie o comprovante</p>
      <a class="btn btn-wa" id="waProof" href="#" target="_blank" rel="noopener">
        📲 Enviar comprovante via WhatsApp
      </a>
    </div>

    <div class="modal-divider">ou pague com cartão</div>
    <a class="btn btn-mp" id="mpLink" href="https://www.mercadopago.com.br" target="_blank" rel="noopener">
      Pagar com Mercado Pago
    </a>
    <p class="modal-foot">Dúvidas? <a href={`https://wa.me/${waNumber}`} target="_blank" rel="noopener">Fale no WhatsApp</a></p>
  </div>
</div>

<script define:vars={{ pixKey, waNumber }}>
  const COUPONS = { COMUNIDADE: 0.20 };
  let basePrice=0, currency='BRL', couponDisc=0, addonPrice=0, addonActive=false, currentName='';
  const sym = () => currency==='EUR'?'€':'R$';
  const fmt = v => sym()+v.toFixed(2).replace('.',',');
  const effective = () => { const b=addonActive&&addonPrice?addonPrice:basePrice; return Math.round(b*(1-couponDisc)*100)/100; };

  function updateDisplay() {
    const t=effective(), pix=Math.round(t*0.9*100)/100;
    document.getElementById('modalSub').textContent=`Valor: ${fmt(t)}`+(couponDisc>0?` (${Math.round(couponDisc*100)}% de desconto)`:'');
    document.getElementById('pixPrice').textContent=fmt(pix);
    document.getElementById('waProof').href=`https://wa.me/${waNumber}?text=${encodeURIComponent(`Olá Cami! Quero enviar o comprovante do PIX para a imersão "${currentName}" (${fmt(pix)}).`)}`;
  }

  function openModal(name, price, cur, addonP, addonLbl) {
    currentName=name; basePrice=parseFloat(price); currency=cur||'BRL';
    couponDisc=0; addonPrice=parseFloat(addonP||0); addonActive=false;
    document.getElementById('couponInput').value='';
    document.getElementById('couponMsg').textContent='';
    document.getElementById('modalTitle').textContent=name;
    const sec=document.getElementById('addonSection');
    if (addonP&&addonLbl) { sec.style.display='block'; document.getElementById('addonLabel').textContent=addonLbl+` — ${sym()}${parseFloat(addonP).toFixed(2).replace('.',',')}`; document.getElementById('addonCheck').checked=false; }
    else sec.style.display='none';
    updateDisplay();
    document.getElementById('payModal').classList.add('open');
    if (window.lenis) window.lenis.stop();
  }
  window.openPayModal = openModal;

  document.getElementById('addonCheck').addEventListener('change',e=>{addonActive=e.target.checked;updateDisplay();});

  document.getElementById('couponApply').addEventListener('click',()=>{
    const code=document.getElementById('couponInput').value.trim().toUpperCase();
    const msg=document.getElementById('couponMsg');
    if (COUPONS[code]!==undefined) { couponDisc=COUPONS[code]; msg.textContent=`✓ Cupom aplicado — ${Math.round(couponDisc*100)}% de desconto`; msg.style.color='var(--orange-deep)'; }
    else { couponDisc=0; msg.textContent=code?'Cupom inválido.':''; msg.style.color='var(--ink-soft)'; }
    updateDisplay();
  });
  document.getElementById('couponInput').addEventListener('keydown',e=>{if(e.key==='Enter') document.getElementById('couponApply').click();});

  document.querySelectorAll('[data-workshop]').forEach(btn=>{
    btn.addEventListener('click',()=>openModal(btn.dataset.workshop,btn.dataset.price,btn.dataset.currency||'BRL',btn.dataset.addonPrice,btn.dataset.addonLabel));
  });

  const closeModal=()=>{ document.getElementById('payModal').classList.remove('open'); if(window.lenis) window.lenis.start(); };
  document.getElementById('modalClose').addEventListener('click',closeModal);
  document.getElementById('payModal').addEventListener('click',e=>{if(e.target.id==='payModal') closeModal();});
  document.addEventListener('keydown',e=>{if(e.key==='Escape') closeModal();});

  document.getElementById('copyBtn').addEventListener('click',async()=>{
    const btn=document.getElementById('copyBtn');
    try { await navigator.clipboard.writeText(pixKey); btn.textContent='✓ Copiado!'; }
    catch { btn.textContent=pixKey; }
    setTimeout(()=>btn.textContent='Copiar chave',2200);
  });
</script>
